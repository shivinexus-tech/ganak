{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ganak.app/schemas/design-decision-manifest.schema.json",
  "title": "Ganak design decision manifest",
  "type": "object",
  "required": ["schemaVersion", "precedence", "decisions", "conflicts", "batchAdmission"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "precedence": {
      "const": ["direct_owner_latest", "direct_owner_earlier", "canonical_human_record", "agent_report", "inference"]
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    },
    "batchAdmission": {
      "type": "object",
      "required": ["allowedStatuses", "fullScreenRequiredReviews", "zeroKnownFindings", "unresolvedConflictsBlock", "visualArtGate", "ornamentLibraryGate"],
      "additionalProperties": false,
      "properties": {
        "allowedStatuses": { "const": ["BLOCKED_FROM_OWNER_REVIEW", "NARROW_PASS", "FULL_SCREEN_PASS"] },
        "fullScreenRequiredReviews": {
          "const": ["mechanical", "accessibility", "ornament_background", "blind_visual", "visual_art", "integrator"]
        },
        "zeroKnownFindings": { "const": true },
        "unresolvedConflictsBlock": { "const": true },
        "visualArtGate": { "$ref": "#/$defs/visualArtGatePolicy" },
        "ornamentLibraryGate": { "$ref": "#/$defs/ornamentLibraryGatePolicy" }
      }
    }
  },
  "$defs": {
    "visualArtGatePolicy": {
      "type": "object",
      "required": ["platform", "requiredForStatuses", "independentReviewer", "exactNodeBinding", "immutableEvidenceBinding", "nodeMutationInvalidates", "requiredScreenJudgements", "requiredOrnamentJudgements"],
      "additionalProperties": false,
      "properties": {
        "platform": { "const": "desktop" },
        "requiredForStatuses": { "const": ["OWNER_REVIEW", "RELEASED", "FULL_SCREEN_PASS"] },
        "independentReviewer": { "const": true },
        "exactNodeBinding": { "const": true },
        "immutableEvidenceBinding": { "const": true },
        "nodeMutationInvalidates": { "const": true },
        "requiredScreenJudgements": { "const": ["background_rationale", "composition_balance", "ornament_inventory", "rejected_resemblance", "open_findings"] },
        "requiredOrnamentJudgements": { "const": ["decision", "purpose", "library_provenance", "space", "alignment", "scale"] }
      }
    },
    "ornamentLibraryGatePolicy": {
      "type": "object",
      "required": ["platform", "requiredForStatuses", "allowedModes", "rejectedModes", "celebratoryContexts", "explorationAdmissible", "creatorMayApprove", "mutationInvalidates", "completeInventoryRequired", "noOrnamentComparisonRequired", "independentVisualArtVerdictRequired"],
      "additionalProperties": false,
      "properties": {
        "platform": { "const": "desktop" },
        "requiredForStatuses": { "const": ["OWNER_REVIEW", "RELEASED", "FULL_SCREEN_PASS"] },
        "allowedModes": { "const": ["RESTRAINED", "RICH", "CELEBRATORY", "NONE"] },
        "rejectedModes": { "const": ["BALANCED"] },
        "celebratoryContexts": { "const": ["festival", "vrat", "ceremonial_hero"] },
        "explorationAdmissible": { "const": false },
        "creatorMayApprove": { "const": false },
        "mutationInvalidates": { "const": true },
        "completeInventoryRequired": { "const": true },
        "noOrnamentComparisonRequired": { "const": true },
        "independentVisualArtVerdictRequired": { "const": true }
      }
    },
    "visualArtEvidence": {
      "type": "object",
      "required": ["platform", "binding", "naturalScaleScreenshots", "contactSheet", "reviewer", "reviewedAt", "screenJudgements", "evidenceDigest"],
      "additionalProperties": false,
      "properties": {
        "platform": { "const": "desktop" },
        "binding": {
          "type": "object",
          "required": ["figmaFile", "sectionNode", "screenNodes", "nodeFingerprints"],
          "additionalProperties": false,
          "properties": {
            "figmaFile": { "type": "string", "minLength": 3 },
            "sectionNode": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
            "screenNodes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" } },
            "nodeFingerprints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["screenNode", "fingerprint"],
                "additionalProperties": false,
                "properties": {
                  "screenNode": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
                  "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            }
          }
        },
        "naturalScaleScreenshots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/visualArtifact" }
        },
        "contactSheet": { "$ref": "#/$defs/contactSheetArtifact" },
        "reviewer": { "$ref": "#/$defs/independentReviewer" },
        "reviewedAt": { "type": "string", "minLength": 20 },
        "screenJudgements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/visualArtScreenJudgement" }
        },
        "evidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "visualArtifact": {
      "type": "object",
      "required": ["screenNode", "url", "artifactDigest"],
      "additionalProperties": false,
      "properties": {
        "screenNode": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "url": { "type": "string", "pattern": "^https://" },
        "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "contactSheetArtifact": {
      "type": "object",
      "required": ["url", "artifactDigest", "memberNodes"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "memberNodes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" } }
      }
    },
    "independentReviewer": {
      "type": "object",
      "required": ["taskId", "independent", "builderTaskIds", "integratorTaskId"],
      "additionalProperties": false,
      "properties": {
        "taskId": { "type": "string", "minLength": 3 },
        "independent": { "const": true },
        "builderTaskIds": { "type": "array", "items": { "type": "string" } },
        "integratorTaskId": { "type": "string", "minLength": 3 }
      }
    },
    "visualArtScreenJudgement": {
      "type": "object",
      "required": ["screenNode", "screenContext", "backgroundRationale", "compositionBalance", "compositionRationale", "ornamentMode", "modeRationale", "permittedContexts", "inventoryComplete", "ornaments", "noOrnamentComparison", "visualArtVerdict", "rejectedResemblance", "rejectedResemblanceRationale", "openFindings"],
      "additionalProperties": false,
      "properties": {
        "screenNode": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "screenContext": { "type": "string", "minLength": 3 },
        "backgroundRationale": { "type": "string", "minLength": 10 },
        "compositionBalance": { "const": "PASS" },
        "compositionRationale": { "type": "string", "minLength": 10 },
        "ornamentMode": { "enum": ["RESTRAINED", "RICH", "CELEBRATORY", "NONE"] },
        "modeRationale": { "type": "string", "minLength": 10 },
        "permittedContexts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "inventoryComplete": { "const": true },
        "ornaments": { "type": "array", "items": { "$ref": "#/$defs/visualArtOrnamentJudgement" } },
        "noOrnamentComparison": { "type": "string", "minLength": 10 },
        "visualArtVerdict": { "const": "PASS" },
        "rejectedResemblance": { "const": "PASS" },
        "rejectedResemblanceRationale": { "type": "string", "minLength": 10 },
        "openFindings": { "const": [] }
      }
    },
    "visualArtOrnamentJudgement": {
      "type": "object",
      "required": ["node", "decision", "namedJob", "libraryRoot", "libraryComponentNode", "provenanceStatus", "creatorTaskId", "curatorTaskId", "curatorIndependent", "placement", "space", "alignment", "scale"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "decision": { "enum": ["keep", "remove", "none"] },
        "namedJob": { "type": "string", "minLength": 3 },
        "libraryRoot": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "libraryComponentNode": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "provenanceStatus": { "enum": ["APPROVED_LIBRARY", "EXPLORATION"] },
        "creatorTaskId": { "type": ["string", "null"] },
        "curatorTaskId": { "type": ["string", "null"] },
        "curatorIndependent": { "type": "boolean" },
        "placement": { "const": "PASS" },
        "space": { "const": "PASS" },
        "alignment": { "const": "PASS" },
        "scale": { "const": "PASS" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["track", "figmaFile", "exactNodes", "allowedRoles", "prohibitedRoles"],
      "additionalProperties": false,
      "properties": {
        "track": { "enum": ["website", "ganak_phone", "global"] },
        "figmaFile": { "type": ["string", "null"] },
        "exactNodes": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" } },
        "imageHashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{40}$" } },
        "cropSignatures": { "type": "array", "items": { "$ref": "#/$defs/crop" } },
        "surfaceFills": { "type": "array", "items": { "type": "string", "pattern": "^#[A-F0-9]{6}$" } },
        "paletteTraits": { "type": "array", "items": { "type": "string", "minLength": 3 } },
        "requiredPlacements": {
          "type": "array",
          "items": { "$ref": "#/$defs/placement" }
        },
        "prohibitedPlacements": {
          "type": "array",
          "items": { "$ref": "#/$defs/placement" }
        },
        "allowedRoles": { "type": "array", "items": { "type": "string" } },
        "prohibitedRoles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "placement": {
      "type": "object",
      "required": ["screenFamily", "slot", "ornamentFamily", "role", "density"],
      "additionalProperties": false,
      "properties": {
        "screenFamily": { "type": "string", "minLength": 1 },
        "slot": { "type": "string", "minLength": 1 },
        "ornamentFamily": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "density": { "type": "string", "minLength": 1 }
      }
    },
    "crop": {
      "type": "object",
      "required": ["wrapper", "raster", "offset", "clips", "contentSignature"],
      "additionalProperties": false,
      "properties": {
        "wrapper": { "$ref": "#/$defs/size" },
        "raster": { "$ref": "#/$defs/size" },
        "offset": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
        },
        "clips": { "const": true },
        "contentSignature": { "type": "string", "minLength": 12 }
      }
    },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "decision": {
      "type": "object",
      "required": ["id", "status", "authority", "decidedAt", "source", "confidence", "scope", "supersedes", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(APP|REJ|PARK|RULE)-[0-9]{3}[A-Z]?$" },
        "status": { "enum": ["approved", "rejected", "parked", "rule"] },
        "authority": { "enum": ["direct_owner_latest", "direct_owner_earlier", "canonical_human_record", "agent_report", "inference"] },
        "decidedAt": { "type": "string", "format": "date" },
        "source": { "type": "string", "minLength": 3 },
        "confidence": { "enum": ["confirmed", "reported", "inferred"] },
        "scope": { "$ref": "#/$defs/scope" },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 10 }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["id", "decisionIds", "status", "resolution"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "decisionIds": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "status": { "enum": ["resolved", "unresolved"] },
        "resolution": { "type": ["string", "null"] }
      }
    }
  }
}
